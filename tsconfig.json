{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@api/DataStore": [
        "./test/stubs/DataStore.ts"
      ]
    },
    "baseUrl": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/plugins/invisiblePgp/codec.ts",
    "src/plugins/invisiblePgp/binding.ts",
    "src/plugins/invisiblePgp/types.ts",
    "src/plugins/invisiblePgp/channelPolicy.ts",
    "src/plugins/invisiblePgp/trustedSigners.ts",
    "src/plugins/invisiblePgp/keyResolver.ts",
    "src/plugins/invisiblePgp/verify.ts",
    "src/plugins/invisiblePgp/publicKeyDetection.ts",
    "src/plugins/invisiblePgp/__tests__/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/plugins/invisiblePgp/**/*.tsx"
  ]
}